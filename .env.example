# MyResearchClaw — local configuration
# Copy this file to .env and fill in the values.
# deploy.sh generates .env automatically; you normally don't need to edit this.

# Python interpreter that has PyMuPDF installed (for PDF extraction)
# deploy.sh will auto-detect this.
MYRESEARCHCLAW_PAPER_READER_PYTHON=/path/to/python

# Codex CLI binary path (default: auto-detected via PATH)
# MYRESEARCHCLAW_CODEX_BIN=codex

# Optional model override. Leave unset to use the Codex CLI default model.
# MYRESEARCHCLAW_MODEL=

# Enable native live web search (`codex --search`) for every agent run.
# MYRESEARCHCLAW_CODEX_SEARCH=true

# Allow workspace-sandbox commands to reach research APIs and paper sources.
# MYRESEARCHCLAW_CODEX_NETWORK=true

# Port for the local server (default: 5678)
# MYRESEARCHCLAW_PORT=5678
