# MyResearchClaw — local configuration
# Copy this file to .env and fill in the values.
# deploy.sh generates .env automatically; you normally don't need to edit this.

# Python interpreter that has PyMuPDF installed (for PDF extraction)
# deploy.sh will auto-detect this.
MYRESEARCHCLAW_PAPER_READER_PYTHON=/path/to/python

# Claude Code CLI binary path (default: auto-detected via PATH)
# MYRESEARCHCLAW_CLAUDE_BIN=claude

# Claude model to use (default: claude-sonnet-4-6)
# MYRESEARCHCLAW_MODEL=claude-sonnet-4-6

# Port for the local server (default: 5678)
# MYRESEARCHCLAW_PORT=5678
